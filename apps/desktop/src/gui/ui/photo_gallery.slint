// Photo album window: thumbnail list of the peer's photos with album filtering
// and send / download actions. All labels come from PhotoGalleryWindow so the
// window follows the application language without extra UiStrings entries.

import { Button, ScrollView } from "std-widgets.slint";

export struct PhotoTile {
    name: string,
    path: string,
    album: string,
    size-text: string,
    modified: string,
    selected: bool,
    has-thumb: bool,
    thumb: image,
}

export component PhotoGalleryWindow inherits Window {
    title: root.window-title;
    width: 940px;
    height: 660px;
    background: #f5f7fa;

    in property <string> window-title: "Photo Album";
    in property <string> peer-name: "";
    in property <string> role-text: "";
    in property <string> album: "";
    in property <[string]> albums: [];
    in property <[PhotoTile]> tiles: [];
    in property <string> status: "";
    in property <string> error: "";
    in property <bool> busy: false;
    in property <bool> connected: true;
    in property <int> selected-count: 0;

    in property <string> text-albums: "Albums";
    in property <string> text-refresh: "Refresh";
    in property <string> text-select-all: "Select all";
    in property <string> text-clear: "Clear";
    in property <string> text-download: "Save to computer";
    in property <string> text-send: "Send photos";
    in property <string> text-paste: "Send clipboard image";
    in property <string> text-selected: "selected";
    in property <string> text-empty: "No photos in this folder yet.";
    in property <string> text-loading: "Loading thumbnails…";
    in property <string> text-open-folder: "Open album folder";
    in property <string> text-up: "Up";
    in property <string> text-root: "Photo root";
    in property <string> current-path: "";

    callback refresh();
    callback album-selected(string);
    callback toggle-tile(int);
    callback select-all();
    callback clear-selection();
    callback download();
    callback send();
    callback paste();
    callback open-folder();
    callback open-photo(int);
    callback up();
    callback root();

    HorizontalLayout {
        padding: 12px;
        spacing: 10px;

        // Left column: album filter.
        Rectangle {
            width: 200px;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e1e7ef;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: root.text-albums;
                    color: #1f2d3d;
                    font-size: 13px;
                    font-weight: 700;
                }
                ScrollView {
                    VerticalLayout {
                        spacing: 2px;
                        for entry[i] in root.albums: Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: root.album == entry ? #e8efff : transparent;
                            Text {
                                text: entry;
                                color: #1f2d3d;
                                font-size: 12px;
                                x: 6px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => { root.album-selected(entry); }
                            }
                        }
                    }
                }
            }
        }

        // Right column: header actions + photo list.
        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.peer-name;
                    color: #1f2d3d;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: root.role-text;
                    color: #6b7c93;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Button {
                    text: root.text-refresh;
                    enabled: !root.busy && root.connected;
                    clicked => { root.refresh(); }
                }
                Button {
                    text: root.text-select-all;
                    enabled: !root.busy && root.connected;
                    clicked => { root.select-all(); }
                }
                Button {
                    text: root.text-clear;
                    enabled: root.selected-count > 0;
                    clicked => { root.clear-selection(); }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: root.text-up;
                    enabled: root.connected && !root.busy;
                    clicked => { root.up(); }
                }
                Button {
                    text: root.text-root;
                    enabled: root.connected && !root.busy;
                    clicked => { root.root(); }
                }
                Text {
                    text: root.current-path;
                    color: #6b7c93;
                    font-size: 10px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: root.text-download;
                    enabled: root.selected-count > 0 && root.connected;
                    clicked => { root.download(); }
                }
                Button {
                    text: root.text-send;
                    enabled: root.connected && !root.busy;
                    clicked => { root.send(); }
                }
                Button {
                    text: root.text-paste;
                    enabled: root.connected && !root.busy;
                    clicked => { root.paste(); }
                }
                Button {
                    text: root.text-open-folder;
                    enabled: root.connected;
                    clicked => { root.open-folder(); }
                }
                Text {
                    text: root.selected-count > 0
                        ? root.selected-count + " " + root.text-selected : "";
                    color: #6b7c93;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: white;
                border-radius: 8px;
                border-width: 1px;
                border-color: #e1e7ef;

                if root.error != "": Text {
                    text: root.error;
                    color: #d65252;
                    font-size: 12px;
                    wrap: word-wrap;
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                }

                if root.error == "": ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        for tile[i] in root.tiles: Rectangle {
                            height: 92px;
                            border-radius: 6px;
                            background: tile.selected ? #eef3ff : #fafbfd;
                            border-width: tile.selected ? 2px : 1px;
                            border-color: tile.selected ? #3564e3 : #e8edf4;

                            Image {
                                x: 8px;
                                y: 6px;
                                width: 80px;
                                height: 80px;
                                source: tile.thumb;
                                image-fit: contain;
                                visible: tile.has-thumb;
                            }
                            Rectangle {
                                x: 8px;
                                y: 6px;
                                width: 80px;
                                height: 80px;
                                background: #eef1f6;
                                border-radius: 4px;
                                visible: !tile.has-thumb;
                                Text {
                                    text: root.text-loading;
                                    color: #8a99ad;
                                    font-size: 9px;
                                    width: parent.width;
                                    height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                            Text {
                                text: tile.name;
                                color: #1f2d3d;
                                font-size: 12px;
                                x: 96px;
                                y: 12px;
                                width: parent.width - 200px;
                                height: 18px;
                                overflow: elide;
                            }
                            Text {
                                text: tile.album + "  ·  " + tile.size-text + "  ·  " + tile.modified;
                                color: #6b7c93;
                                font-size: 10px;
                                x: 96px;
                                y: 32px;
                                width: parent.width - 200px;
                                height: 16px;
                                overflow: elide;
                            }
                            Text {
                                text: tile.path;
                                color: #9aa8ba;
                                font-size: 9px;
                                x: 96px;
                                y: 52px;
                                width: parent.width - 200px;
                                height: 14px;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => { root.toggle-tile(i); }
                                double-clicked => { root.open-photo(i); }
                            }
                        }
                    }
                }

                if root.connected && root.tiles.length == 0 && root.error == "" && !root.busy: Text {
                    text: root.text-empty;
                    color: #6b7c93;
                    font-size: 12px;
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                }
            }

            Text {
                text: root.error != "" ? root.error : root.status;
                color: root.error != "" ? #d65252 : #6b7c93;
                font-size: 11px;
                height: 16px;
                overflow: elide;
            }
        }
    }
}
